import 'dart:convert';
import 'dart:math';
import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;
import '../services/safepark_store.dart';
import '../utils/theme_constants.dart';

class AlertsNavIcon extends StatelessWidget {
  final int count;
  final bool selected;
  const AlertsNavIcon({super.key, required this.count, required this.selected});

  @override
  Widget build(BuildContext context) {
    final baseIcon = Icon(
      selected ? Icons.notifications : Icons.notifications_outlined,
      color: selected ? Colors.white : Colors.white70,
    );
    if (count <= 0) return baseIcon;
    return Badge(
      label: Text('$count', style: const TextStyle(fontSize: 10, fontWeight: FontWeight.bold)),
      backgroundColor: const Color(0xFFE0584F),
      child: baseIcon,
    );
  }
}

class AlertCard extends StatelessWidget {
  final String badge;
  final String title;
  final List<String> subLines;
  final String body;
  final String? imgBase64;
  final Widget? footer;

  const AlertCard({
    super.key,
    required this.badge,
    required this.title,
    required this.subLines,
    required this.body,
    this.imgBase64,
    this.footer,
  });

  @override
  Widget build(BuildContext context) {
    Uint8List? bytes;
    if (imgBase64 != null && imgBase64!.isNotEmpty) {
      try {
        bytes = base64Decode(imgBase64!);
      } catch (_) {}
    }

    return Card(
      margin: const EdgeInsets.only(bottom: 10),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: Padding(
        padding: const EdgeInsets.all(14),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Expanded(child: Text(title, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 15))),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                  decoration: BoxDecoration(
                    color: const Color(0xFFE6EEE3),
                    borderRadius: BorderRadius.circular(5),
                  ),
                  child: Text(
                    badge,
                    style: const TextStyle(fontSize: 11, fontWeight: FontWeight.w600, color: Color(0xFF41594A)),
                  ),
                ),
              ],
            ),
            for (final line in subLines)
              Padding(
                padding: const EdgeInsets.only(top: 2),
                child: Text(line, style: TextStyle(color: Theme.of(context).hintColor, fontSize: 12)),
              ),
            const SizedBox(height: 6),
            Text(body, style: const TextStyle(fontSize: 14)),
            if (bytes != null) ...[
              const SizedBox(height: 8),
              ClipRRect(
                borderRadius: BorderRadius.circular(9),
                child: Image.memory(bytes, width: double.infinity, height: 170, fit: BoxFit.cover),
              ),
            ],
            if (footer != null) ...[
              const SizedBox(height: 10),
              footer!,
            ],
          ],
        ),
      ),
    );
  }
}

class EmptyPlaceholder extends StatelessWidget {
  final IconData icon;
  final String text;
  const EmptyPlaceholder({super.key, required this.icon, required this.text});

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(top: 70),
      child: Column(
        children: [
          Icon(icon, size: 42, color: Theme.of(context).hintColor),
          const SizedBox(height: 10),
          Text(text, textAlign: TextAlign.center, style: TextStyle(color: Theme.of(context).hintColor)),
        ],
      ),
    );
  }
}

const String _kAnthropicApiKey = '';

class AiAssistantPanel extends StatefulWidget {
  final SafeParkStore store;
  final VoidCallback onClose;

  const AiAssistantPanel({super.key, required this.store, required this.onClose});

  @override
  State<AiAssistantPanel> createState() => _AiAssistantPanelState();
}

class _AiAssistantPanelState extends State<AiAssistantPanel> {
  final _inputCtrl = TextEditingController();
  final List<({String text, bool isUser})> _messages = [
    (
      text: 'Hi! I’m your SafePark AI agent. Ask me anything about car problems: it won’t start, strange noises, warning lights, tires, brakes, overheating, or how to use the app.',
      isUser: false,
    ),
  ];
  final List> _history = [];
  bool _busy = false;

  @override
  void dispose() {
    _inputCtrl.dispose();
    super.dispose();
  }

  String _offlineAnswer(String rawQ) {
    final q = rawQ.toLowerCase();
    const rules = <({List<String> keys, String reply})>[
      (
        keys: ['smoke', 'fire', 'burning smell', 'fuel smell', 'gas smell', 'petrol smell'],
        reply:
            'Safety first: pull over, turn the engine off, get everyone out and stay away from the car. If you see flames or smell fuel, call emergency services (Emergency tab).',
      ),
      (
        keys: ['brake', 'braking', 'brakes', 'squeal', 'grinding', 'spongy pedal'],
        reply:
            'Brake problems:\n1. Squealing: worn pads.\n2. Grinding: pads gone, discs damaged—stop driving.\n3. Soft pedal: low fluid or leak—call a tow truck.',
      ),
      (
        keys: ["won't start", 'wont start', 'not starting', 'dead battery', 'battery', 'jump', 'clicking'],
        reply:
            'Car won\'t start:\n1. Rapid clicking/dim lights: weak battery—try a jump start.\n2. One loud click or silence: possible starter issue.\n3. Cranks without catching: check fuel or spark plugs.',
      ),
      (
        keys: ['overheat', 'overheating', 'temperature', 'coolant', 'radiator', 'steam'],
        reply:
            'Overheating:\n1. Pull over safely and shut off the engine.\n2. Wait 30 minutes before opening the hood; never open a hot radiator cap.',
      ),
      (
        keys: ['flat', 'tire', 'tyre', 'puncture', 'pressure', 'blowout'],
        reply:
            'Tires:\n1. Slow down gradually, park safely, use your spare or call a tow service.\n2. Check recommended PSI inside the driver\'s door jamb.',
      ),
    ];

    for (final r in rules) {
      if (r.keys.any((k) => q.contains(k))) {
        return '${r.reply}\n\n(Offline guide)';
      }
    }
    if (q.contains('qr') || q.contains('scan')) {
      return 'Tap "Scan a QR code" on the Report screen and allow camera access, or type the car code instead.';
    }
    return 'Tell me what the car is doing: when it happens, any noises, smells, or warning lights, and the car\'s make and year.\n\n(Offline guide)';
  }

  Future<void> _send() async {
    if (_busy) return;
    final text = _inputCtrl.text.trim();
    if (text.isEmpty) return;
    _inputCtrl.clear();

    setState(() {
      _messages.add((text: text, isUser: true));
      _busy = true;
    });
    _history.add({'role': 'user', 'content': text});

    String reply;
    if (_kAnthropicApiKey.isNotEmpty) {
      try {
        final res = await http.post(
          Uri.parse('https://api.anthropic.com/v1/messages'),
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': _kAnthropicApiKey,
            'anthropic-version': '2023-06-01',
          },
          body: jsonEncode({
            'model': 'claude-sonnet-4-6',
            'max_tokens': 800,
            'system': 'You are the SafePark AI mechanic assistant. Give clear, safety-first answers under 150 words.',
            'messages': _history.skip(max(0, _history.length - 12)).toList(),
          }),
        );
        if (res.statusCode >= 200 && res.statusCode < 300) {
          final data = jsonDecode(res.body) as Map<String, dynamic>;
          final content = (data['content'] as List?) ?? [];
          reply = content
              .where((i) => (i as Map)['type'] == 'text')
              .map((i) => (i as Map)['text'].toString())
              .join('\n')
              .trim();
          if (reply.isEmpty) reply = _offlineAnswer(text);
        } else {
          reply = _offlineAnswer(text);
        }
      } catch (_) {
        reply = _offlineAnswer(text);
      }
    } else {
      reply = _offlineAnswer(text);
    }

    _history.add({'role': 'assistant', 'content': reply});
    if (mounted) {
      setState(() {
        _messages.add((text: reply, isUser: false));
        _busy = false;
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    final pal = kPalettes[widget.store.paletteIndex];
    return Material(
      elevation: 10,
      borderRadius: BorderRadius.circular(20),
      color: Theme.of(context).scaffoldBackgroundColor,
      child: Column(
        children: [
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
            decoration: BoxDecoration(
              color: pal.priDark,
              borderRadius: const BorderRadius.vertical(top: Radius.circular(20)),
            ),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                const Text('SafePark AI Agent', style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                IconButton(icon: const Icon(Icons.close, color: Colors.white), onPressed: widget.onClose),
              ],
            ),
          ),
          Expanded(
            child: ListView.builder(
              padding: const EdgeInsets.all(12),
              itemCount: _messages.length + (_busy ? 1 : 0),
              itemBuilder: (context, i) {
                if (_busy && i == _messages.length) {
                  return const Align(
                    alignment: Alignment.centerLeft,
                    child: Padding(
                      padding: EdgeInsets.all(8),
                      child: Text('Thinking…', style: TextStyle(fontStyle: FontStyle.italic)),
                    ),
                  );
                }
                final m = _messages[i];
                return Align(
                  alignment: m.isUser ? Alignment.centerRight : Alignment.centerLeft,
                  child: Container(
                    margin: const EdgeInsets.only(bottom: 8),
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                    constraints: const BoxConstraints(maxWidth: 300),
                    decoration: BoxDecoration(
                      color: m.isUser ? pal.pri : Theme.of(context).cardColor,
                      borderRadius: BorderRadius.circular(14),
                      border: m.isUser ? null : Border.all(color: Theme.of(context).dividerColor),
                    ),
                    child: Text(m.text, style: TextStyle(color: m.isUser ? Colors.white : null, fontSize: 13)),
                  ),
                );
              },
            ),
          ),
          Container(
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: Theme.of(context).cardColor,
              border: Border(top: BorderSide(color: Theme.of(context).dividerColor)),
            ),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _inputCtrl,
                    onSubmitted: (_) => _send(),
                    decoration: const InputDecoration(
                      hintText: 'Ask a question...',
                      border: OutlineInputBorder(),
                      isDense: true,
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                FilledButton(
                  style: FilledButton.styleFrom(backgroundColor: pal.pri),
                  onPressed: _send,
                  child: const Text('Send'),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }
}
