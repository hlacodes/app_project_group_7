class EmergencyContact {
  String name;
  String number;
  EmergencyContact({required this.name, required this.number});

  Map<String, dynamic> toJson() => {'n': name, 'v': number};
  factory EmergencyContact.fromJson(Map<String, dynamic> j) =>
      EmergencyContact(name: (j['n'] ?? '').toString(), number: (j['v'] ?? '').toString());
}

class PricingPlan {
  String name;
  String price;
  String period;
  List<String> features;
  bool highlight;

  PricingPlan({
    required this.name,
    required this.price,
    required this.period,
    required this.features,
    this.highlight = false,
  });

  Map<String, dynamic> toJson() => {
        'n': name,
        'p': price,
        'per': period,
        'f': features,
        'hl': highlight,
      };

  factory PricingPlan.fromJson(Map<String, dynamic> j) => PricingPlan(
        name: (j['n'] ?? '').toString(),
        price: (j['p'] ?? '').toString(),
        period: (j['per'] ?? '').toString(),
        features: ((j['f'] as List?) ?? []).map((e) => e.toString()).toList(),
        highlight: j['hl'] == true,
      );
}

class RegisteredCar {
  final String owner;
  final String name;
  final String code;

  RegisteredCar({required this.owner, required this.name, required this.code});

  Map<String, dynamic> toJson() => {'owner': owner, 'name': name, 'code': code};
  factory RegisteredCar.fromJson(Map<String, dynamic> j) => RegisteredCar(
        owner: (j['owner'] ?? '').toString(),
        name: (j['name'] ?? '').toString(),
        code: (j['code'] ?? '').toString(),
      );
}

class CarReport {
  final int id;
  final String car;
  final String kind;
  final String text;
  final String loc;
  final String user;
  String status; // open | resolved | blocked
  final String? imgBase64;

  CarReport({
    required this.id,
    required this.car,
    required this.kind,
    required this.text,
    this.loc = '',
    required this.user,
    this.status = 'open',
    this.imgBase64,
  });

  Map<String, dynamic> toJson() => {
        'id': id,
        'car': car,
        'kind': kind,
        'text': text,
        'loc': loc,
        'user': user,
        'status': status,
        'img': imgBase64,
      };

  factory CarReport.fromJson(Map<String, dynamic> j) => CarReport(
        id: (j['id'] as num?)?.toInt() ?? 0,
        car: (j['car'] ?? '').toString(),
        kind: (j['kind'] ?? '').toString(),
        text: (j['text'] ?? '').toString(),
        loc: (j['loc'] ?? '').toString(),
        user: (j['user'] ?? '').toString(),
        status: (j['status'] ?? 'open').toString(),
        imgBase64: j['img']?.toString(),
      );
}

class AlertItem {
  final int id;
  final String to;
  final String car;
  final String kind;
  final String text;
  final String loc;
  final String? imgBase64;
  bool read;
  String reply;
  final int ts;
  final bool ver;
  final String? eta;
  final bool fwd;
  String? fwdTo;
  bool rep1;

  AlertItem({
    required this.id,
    required this.to,
    required this.car,
    required this.kind,
    required this.text,
    this.loc = '',
    this.imgBase64,
    this.read = false,
    this.reply = '',
    required this.ts,
    this.ver = false,
    this.eta,
    this.fwd = false,
    this.fwdTo,
    this.rep1 = false,
  });

  Map<String, dynamic> toJson() => {
        'id': id,
        'to': to,
        'car': car,
        'kind': kind,
        'text': text,
        'loc': loc,
        'img': imgBase64,
        'read': read,
        'reply': reply,
        'ts': ts,
        'ver': ver,
        'eta': eta,
        'fwd': fwd,
        'fwdTo': fwdTo,
        'rep1': rep1,
      };

  factory AlertItem.fromJson(Map<String, dynamic> j) => AlertItem(
        id: (j['id'] as num?)?.toInt() ?? 0,
        to: (j['to'] ?? '').toString(),
        car: (j['car'] ?? '').toString(),
        kind: (j['kind'] ?? '').toString(),
        text: (j['text'] ?? '').toString(),
        loc: (j['loc'] ?? '').toString(),
        imgBase64: j['img']?.toString(),
        read: j['read'] == true,
        reply: (j['reply'] ?? '').toString(),
        ts: (j['ts'] as num?)?.toInt() ?? 0,
        ver: j['ver'] == true,
        eta: j['eta']?.toString(),
        fwd: j['fwd'] == true,
        fwdTo: j['fwdTo']?.toString(),
        rep1: j['rep1'] == true,
      );
}

class ClassSlot {
  final int day; // 0=Sun..6=Sat
  final String start;
  final String end;
  ClassSlot({required this.day, required this.start, required this.end});

  Map<String, dynamic> toJson() => {'d': day, 's': start, 'e': end};
  factory ClassSlot.fromJson(Map<String, dynamic> j) => ClassSlot(
        day: (j['d'] as num?)?.toInt() ?? 0,
        start: (j['s'] ?? '09:00').toString(),
        end: (j['e'] ?? '10:00').toString(),
      );
}
